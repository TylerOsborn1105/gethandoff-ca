---
import Page from '../../layouts/Page.astro';
import { answers } from '../../lib/content.js';

export function getStaticPaths() {
  return answers().map((a) => ({ params: { slug: a.slug }, props: { entry: a } }));
}
const { entry } = Astro.props;
const { data, Content } = entry;
const site = Astro.site.href.replace(/\/$/, '');
const url = `${site}/answers/${entry.slug}/`;
const author = { '@type': 'Person', name: 'Tyler Calderwood', url: `${site}/` };
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'Article',
    headline: data.h1, description: data.description, url, mainEntityOfPage: url,
    datePublished: data.published, dateModified: data.updated, inLanguage: 'en-CA',
    author, publisher: { '@type': 'Organization', name: 'Handoff', url: `${site}/`, logo: `${site}/favicon.svg` },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Handoff', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: 'Plain answers', item: `${site}/answers/` },
      { '@type': 'ListItem', position: 3, name: data.h1, item: url },
    ],
  },
];
---
<Page title={data.title} description={data.description} h1={data.h1} dek={data.dek}
      updated={data.updated} draft={data.draft} schema={schema}>
  <Content />
</Page>
