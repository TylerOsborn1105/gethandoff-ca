---
import Page from '../../layouts/Page.astro';
import { answers } from '../../lib/content.js';
const list = answers();
const site = Astro.site.href.replace(/\/$/, '');
const schema = [{
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Plain answers',
  url: `${site}/answers/`, isPartOf: { '@type': 'WebSite', name: 'Handoff', url: `${site}/` },
}];
---
<Page
  title="Plain answers about AI for small businesses | Handoff BC"
  description="Plain answers to what small business owners in Delta and the Lower Mainland ask about AI: where to start, what it costs, what’s safe, and which tool fits."
  h1="Plain answers"
  dek="Straight answers to the questions small business owners ask about AI. No jargon, and no pitch if you don't need it."
  showByline={false}
  schema={schema}
>
  <p class="support">Everything taught in plain English, so you can actually use it at work.</p>
  {list.length ? (
    <ul class="list">
      {list.map((a) => (
        <li>
          <a href={`/answers/${a.slug}/`}>{a.data.h1}</a>
          <p>{a.data.dek}</p>
        </li>
      ))}
    </ul>
  ) : (
    <p>New answers are on the way. In the meantime, the free hour is the fastest way to get yours.</p>
  )}
</Page>

<style>
  .support{
    margin:-4px 0 32px;
    color:var(--ink-2);
    font-size:clamp(17px,1.7vw,19px);
    line-height:1.45;
    text-wrap:pretty;
  }
</style>
