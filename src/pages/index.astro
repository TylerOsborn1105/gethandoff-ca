---
// The homepage is the finished design, kept as one hand-built file.
// Analytics and Speed Insights go in <head>, same as the shared layout.
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import html from '../home.html?raw';
import motionCss from '../styles/motion.css?raw';
import cursorCss from '../styles/cursor.css?raw';
import reportCardCss from '../styles/report-card.css?raw';

const headClose = html.indexOf('</head>');
if (headClose === -1) {
  throw new Error('Homepage HTML is missing </head>');
}
const beforeHeadClose = html.slice(0, headClose);
const afterHeadClose = html.slice(headClose);
---
<Fragment set:html={beforeHeadClose} />
<style is:inline set:html={motionCss}></style>
<style is:inline set:html={cursorCss}></style>
<style is:inline set:html={reportCardCss}></style>
<Analytics />
<SpeedInsights />
<script is:inline>
  (function(c,l,a,r,i,t,y){
    c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
    t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
    y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
  })(window, document, "clarity", "script", "yytas3p3vi");
</script>
<Fragment set:html={afterHeadClose} />
